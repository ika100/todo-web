{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@24",
    "pnpm@11.22.0",
    "detect-secrets@latest",
    "trivy@latest",
    "git@latest",
    "gh@latest"
  ],
  "shell": {
    "init_hook": ["[ -d node_modules ] || pnpm install 2>/dev/null || true"],
    "scripts": {
      "install":      "pnpm install --frozen-lockfile",
      "dev":          "pnpm dev",
      "build":        "pnpm build",
      "test":         "pnpm test",
      "test-fast":    "pnpm test:fast",
      "spec-check":   "bash scripts/spec-check.sh",
      "lint":         "pnpm lint",
      "lint-fix":     "pnpm lint:fix",
      "typecheck":    "pnpm typecheck",
      "quality":      "devbox run lint && devbox run typecheck",
      "audit":        "pnpm audit --prod --audit-level high",
      "secrets-scan": "git ls-files -z ':!pnpm-lock.yaml' | xargs -0 detect-secrets-hook --baseline .secrets.baseline.json",
      "security":     "devbox run audit && devbox run secrets-scan",
      "image-build":  "docker build -t todo-web:scan .",
      "image-scan":   "trivy image --severity CRITICAL,HIGH --format table todo-web:scan",
      "bundle-check": "bash scripts/bundle-check.sh"
    }
  }
}
